{
  "name": "@tty-pt/axil",
  "version": "1.8.4",
  "type": "module",
  "description": "Universal Node.js and Browser client and N-API daemon host for axil network transport and persistent socket multiplexing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "axil": "./bin/axil.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cap": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./bin/axil.js": "./bin/axil.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "prebuilds",
    "include",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/axil.test.mjs"
  },
  "dependencies": {
    "@tty-pt/stele": "^1.7.1"
  },
  "peerDependencies": {
    "@tty-pt/stele": ">=1.7.0"
  },
  "devDependencies": {
    "@tty-pt/stele": "^1.7.1"
  },
  "keywords": [
    "axil",
    "network",
    "websocket",
    "multiplexer",
    "transport",
    "wasm",
    "web-hal",
    "napi"
  ],
  "author": "Paulo Quirino",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/axil.git",
    "directory": "npm"
  },
  "homepage": "https://tty.pt"
}
